# ==============================
# .htaccess optimizado en raíz
# ==============================

# Activa el motor de reescritura
RewriteEngine On

# Permite acceso directo a archivos y carpetas esenciales
RewriteCond %{REQUEST_URI} !^/(index\.php|robots\.txt|sitemap\.xml|assets|favicon\.ico)

# Si el archivo o directorio existe, no lo reescribas
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirige todas las demás solicitudes a index.php
RewriteRule ^(.*)$ index.php/$1 [L,QSA]

# ==============================
# Seguridad básica
# ==============================

# Deshabilita listado de directorios
Options -Indexes

# Oculta el archivo .htaccess
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Protege archivos sensibles
<FilesMatch "(composer\.json|composer\.lock|\.env|\.gitignore|\.git)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Bloquea el acceso directo a las carpetas internas de la aplicación
RedirectMatch 403 ^/(application|system|tests|assets/(?!.*\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|eot))).*$

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ==============================
# Rendimiento
# ==============================

# Habilita compresión gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache de recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
