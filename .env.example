# Copy to .env for local development. It is read only when the development
# dependencies are installed, and real environment variables always win.
# Generate APP_KEY with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CI_ENV=development
APP_KEY=
APP_URL=http://localhost:8000
APP_SETUP_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# TRUSTED_PROXIES=
# LOG_THRESHOLD=1
# LOG_CHANNEL=stderr
# SESSION_DRIVER=files
# SESSION_SAVE_PATH=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
